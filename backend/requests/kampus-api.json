        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON yanıtı', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const data = pm.response.json();",
              "pm.test('Beklenen içerik', () => { pm.expect(data.status).to.eql('ok'); pm.expect(data.student).to.eql('2321032070'); pm.expect(new Date(data.time).toISOString()).to.eql(data.time); });"
            ]
          }
        }
      ]
    },
