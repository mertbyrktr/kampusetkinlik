    {
      "name": "5 Etkinlik oluştur (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Git Atölyesi\",\n  \"category\": \"Atölye\",\n  \"capacity\": 30,\n  \"date\": \"2026-12-01\",\n  \"time\": \"14:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 1\",\n  \"description\": \"Git ve GitHub ile ilk adımlar.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON yanıtı', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const data = pm.response.json();",
              "pm.test('Beklenen içerik', () => { pm.expect(data.id).to.match(/^event-/); pm.expect(data.id).not.to.eql('event-2'); const sent = JSON.parse(pm.request.body.raw); Object.keys(sent).forEach(key => pm.expect(data[key]).to.eql(sent[key])); });"
            ]
          }
        }
      ]
    },
